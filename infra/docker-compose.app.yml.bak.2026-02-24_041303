services:
  api:
    build:
      context: ..
      dockerfile: Dockerfile
    container_name: daiso-api
    command: >
      gunicorn backend.main:app
      --worker-class uvicorn.workers.UvicornWorker
      --workers 4
      --bind 0.0.0.0:8000
      --timeout 60
      --worker-tmp-dir /tmp
      --control-socket /tmp/gunicorn.ctl
    env_file:
      - ../.env
    ports:
      - "8000:8000"
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      GOOGLE_APPLICATION_CREDENTIALS: /run/secrets/daisoproject-sst.json
      SEARCH_MODE: "hybrid"
    volumes:
      - ../backend/database:/app/backend/database:ro
      - ../secrets/daisoproject-sst.json:/run/secrets/daisoproject-sst.json:ro
    restart: always
    healthcheck:
      #test: ["CMD-SHELL", "curl -fsS http://localhost:8000/health || exit 1"]
      #interval: 30s
      #retries: 5
      #start_period: 30s
      #timeout: 10s
      #test: ["CMD-SHELL", "curl -fsS http://localhost:8000/healthz || exit 1"]
      #interval: 30s
      #retries: 5
      #start_period: 30s
      #timeout: 10s
      #test: ["CMD-SHELL", "curl -fsS --connect-timeout 1 --max-time 2 http://localhost:8000/healthz || exit 1"]
      #interval: 30s
      #retries: 5
      #start_period: 30s
      #timeout: 3s
      test: ["CMD-SHELL", "curl -fsS --max-time 1 http://localhost:8000/healthz || exit 1"]
      interval: 10s
      retries: 10
      start_period: 60s
      timeout: 2s

  frontend:
    build:
      context: ../frontend
      dockerfile: Dockerfile
      args:
        NEXT_PUBLIC_API_URL: http://3.39.6.105:8000
    container_name: daiso-frontend
    ports:
      - "3000:3000"
    restart: always
