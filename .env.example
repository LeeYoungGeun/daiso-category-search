# ─── Environment Configuration Template ───
# 이 파일을 .env로 복사 후 실제 값 입력
#
# 로컬 개발: cp .env.local .env
# 라이브:    cp .env.live .env

# GOOGLE
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products

# Elasticsearch
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=products

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

# Search Parameters
SEARCH_TOP_K_BM25=30
SEARCH_TOP_K_DENSE=30
SEARCH_TOP_K_FUSED=10
SEARCH_RRF_K=60
SEARCH_FUSION_METHOD=rrf

# CORS (도메인 추가 시)
CORS_ORIGIN=http://localhost:3000

# Rerank
RERANK_MODE=local
VENDOR_ENABLED=false
VENDOR_SAMPLE_RATE=0
VENDOR_MAX_CALLS_PER_MIN=0
