#[기존] ─── Environment Configuration Template ───
# 이 파일을 .env로 복사 후 실제 값 입력
#
# 로컬 개발: cp .env.local .env
# 라이브:    cp .env.live .env

# GOOGLE
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=products

# Elasticsearch
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=
ELASTIC_INDEX=products

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

# Search Parameters
SEARCH_TOP_K_BM25=30
SEARCH_TOP_K_DENSE=30
SEARCH_TOP_K_FUSED=10
SEARCH_RRF_K=60
SEARCH_FUSION_METHOD=rrf

# CORS (도메인 추가 시)
CORS_ORIGIN=http://localhost:3000

# Rerank
RERANK_MODE=local
VENDOR_ENABLED=false
VENDOR_SAMPLE_RATE=0
VENDOR_MAX_CALLS_PER_MIN=0


# # [수정버전] ─── Live / Production Environment ───
# # 서버 A (App) → 서버 B (Search/Data) 통신 설정
# #
# # 서버 A (App):     3.39.6.105   — Nginx(호스트) + Docker(API+FE)
# # 서버 B (Data):    54.180.1.204 — Docker(ES+Qdrant+Redis)
# #
# # 도메인 사용 시 CORS_ORIGIN과 nginx server_name만 변경
# 
# # GOOGLE
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# 
# # ── 서버 B (54.180.1.204) 서비스 ──
# 
# # Qdrant
# QDRANT_URL=http://54.180.1.204:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=products
# 
# # Elasticsearch
# ELASTIC_URL=http://54.180.1.204:9200
# ELASTIC_API_KEY=
# ELASTIC_INDEX=products
# 
# # Redis
# REDIS_URL=redis://54.180.1.204:6379/0
# 
# # ── 검색 파라미터 ──
# 
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-001
# 
# SEARCH_TOP_K_BM25=30
# SEARCH_TOP_K_DENSE=30
# SEARCH_TOP_K_FUSED=10
# SEARCH_RRF_K=60
# SEARCH_FUSION_METHOD=rrf
# 
# # ── CORS (도메인 추가 시 여기에 입력) ──
# # CORS_ORIGIN=http://3.39.6.105
# CORS_ORIGIN=http://3.39.6.105:3000
# 
# 
# # Rerank
# RERANK_MODE=local
# VENDOR_ENABLED=false
# VENDOR_SAMPLE_RATE=0
# VENDOR_MAX_CALLS_PER_MIN=0
# 
# # [PATCH] Safety/Hybrid toggles
# # SAFE_MODE=1        # 외부 LLM 호출 차단 (NLU/확장/리랭크)
# # DISABLE_HYBRID=1   # 하이브리드 검색(Elastic/Qdrant) 차단 → SQLite fallback
# # SEARCH_MODE=bm25_only Elastic이 살아있으면 bm25_only로 검색 Elastic도 죽으면 자동 sqlite_fallback
# FORCE_SQLITE=0
# DISABLE_HYBRID=1
# SEARCH_MODE=auto
# GEMINI_MODEL=gemini-2.5-flash
# SAFE_MODE=1
# 
# # [PATCH] Hybrid init/health-check timeout & circuit breaker
# # HYBRID_HEALTH_TIMEOUT_S=0.7
# # HYBRID_BREAKER_COOLDOWN_S=30
# # ELASTIC_HEALTH_TIMEOUT_S=0.7
# # QDRANT_HEALTH_TIMEOUT_S=0.7


